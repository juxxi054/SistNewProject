<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="boot.data.mapper.BoardMapperInter">
  <select id="getTotalCount" resultType="int" parameterType="Map" >
  select count(*) from memboard
  <if test="searchcolum!=null and searchword!=null!">
  where ${searchcolum} like concat('%',#{searchword},'%')
  </if>  
  </select>
  <insert id="insertBoard">
  insert into memboard(name,myid,subject,count,uploadfile,writeday)
  values (#{name},#{myid},#{subject},#{content},#{uploadfole},now())
  </insert>
  <select id="getMaxNum"></select>
  <select id="getList">
    
  </select>
  <select id="getData"></select>
  <update id="updateReadcount"></update>
</mapper>